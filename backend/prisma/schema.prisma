generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  phone         String?
  password      String
  role          String         @default("USER")
  status        String         @default("active")
  avatar        String?
  isHost        Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("create_time")
  updatedAt     DateTime       @updatedAt
  levelId       String?        @map("level_id")
  points        Int            @default(0) @map("points")
  totalPoints   Int            @default(0) @map("total_points")
  favorites     Favorite[]
  notifications Notification[]
  orders        Order[]
  pointLogs     PointLog[]
  reviews       Review[]
  level         MemberLevel?   @relation(fields: [levelId], references: [id])

  @@map("users")
}

model MemberLevel {
  id         String   @id @default(cuid())
  name       String
  nameEn     String   @map("name_en")
  minPoints  Int      @unique @map("min_points")
  maxPoints  Int      @map("max_points")
  discount   Int      @default(0)
  pointsRate Int      @default(1) @map("points_rate")
  icon       String?
  color      String?
  benefits   String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  users      User[]

  @@index([sortOrder])
  @@map("member_levels")
}

model PointLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  points      Int
  balance     Int
  type        String
  relatedId   String?  @map("related_id")
  relatedType String?  @map("related_type")
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("point_logs")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  houseId   String   @map("house_id")
  createdAt DateTime @default(now()) @map("created_at")
  house     Homestay @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, houseId])
  @@map("favorites")
}

model Homestay {
  id          String       @id @default(cuid())
  title       String
  location    String
  price       Int
  rating      Float        @default(4.5)
  reviews     Int          @default(0)
  images      String[]
  type        String
  guests      Int
  bedrooms    Int
  beds        Int
  bathrooms   Int
  amenities   String[]
  description String?
  isFavorite  Boolean      @default(false)
  hostName    String
  hostAvatar  String
  isSuperhost Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  favorites   Favorite[]
  stocks      HouseStock[]
  orders      Order[]
  reviewList  Review[]

  @@map("homestays")
}

model HouseStock {
  id          String   @id @default(cuid())
  houseId     String   @map("house_id")
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookedStock Int      @default(0) @map("booked_stock")
  price       Int?
  totalStock  Int      @default(1) @map("total_stock")
  house       Homestay @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@unique([houseId, date])
  @@index([date])
  @@map("house_stocks")
}

model Order {
  id         String    @id @default(cuid())
  orderId    String    @unique @map("order_id")
  userId     String    @map("user_id")
  houseId    String    @map("house_id")
  type       String    @default("homestay")
  itemName   String    @map("item_name")
  totalPrice Int       @map("total_price")
  status     String    @default("pending")
  checkIn    DateTime? @map("check_in")
  checkOut   DateTime? @map("check_out")
  guests     Int?
  createdAt  DateTime  @default(now()) @map("create_time")
  updatedAt  DateTime  @updatedAt
  house      Homestay  @relation(fields: [houseId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
  review     Review?

  @@map("orders")
}

model MealConfig {
  id          String      @id @default(cuid())
  name        String
  description String?
  image       String
  price       Int
  mealType    String      @map("meal_type")
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("create_time")
  updatedAt   DateTime    @updatedAt
  orders      MealOrder[]

  @@map("meal_configs")
}

model MealOrder {
  id           String     @id @default(cuid())
  roomNumber   String     @map("room_number")
  mealConfigId String     @map("meal_config_id")
  mealType     String     @map("meal_type")
  peopleCount  Int        @map("people_count")
  totalPrice   Int        @map("total_price")
  remark       String?
  status       String     @default("CONFIRMED")
  createdAt    DateTime   @default(now()) @map("create_time")
  updatedAt    DateTime   @updatedAt
  mealConfig   MealConfig @relation(fields: [mealConfigId], references: [id])

  @@map("meal_orders")
}

model CarConfig {
  id          String      @id @default(cuid())
  name        String
  description String?
  image       String
  price       Int
  carType     String      @map("car_type")
  seats       Int
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("create_time")
  updatedAt   DateTime    @updatedAt
  driverFee   Int         @default(0) @map("driver_fee")
  hasDriver   Boolean     @default(true) @map("has_driver")
  rentals     CarRental[]
  stocks      CarStock[]

  @@map("car_configs")
}

model CarRental {
  id          String    @id @default(cuid())
  roomNumber  String    @map("room_number")
  carConfigId String    @map("car_config_id")
  startTime   DateTime  @map("start_time")
  endTime     DateTime  @map("end_time")
  days        Int
  totalPrice  Int       @map("total_price")
  remark      String?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("create_time")
  updatedAt   DateTime  @updatedAt
  driverFee   Int?      @map("driver_fee")
  driverId    String?   @map("driver_id")
  needDriver  Boolean   @default(false) @map("need_driver")
  carConfig   CarConfig @relation(fields: [carConfigId], references: [id])
  driver      Driver?   @relation(fields: [driverId], references: [id])

  @@map("car_rentals")
}

model CarStock {
  id          String    @id @default(cuid())
  carConfigId String    @map("car_config_id")
  date        DateTime  @db.Date
  totalStock  Int       @default(1) @map("total_stock")
  bookedStock Int       @default(0) @map("booked_stock")
  price       Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  carConfig   CarConfig @relation(fields: [carConfigId], references: [id], onDelete: Cascade)

  @@unique([carConfigId, date])
  @@index([date])
  @@map("car_stocks")
}

model Driver {
  id            String           @id @default(cuid())
  name          String
  phone         String
  avatar        String?
  licenseNumber String?          @map("license_number")
  status        String           @default("active")
  dailyFee      Int              @default(0) @map("daily_fee")
  remark        String?
  createdAt     DateTime         @default(now()) @map("create_time")
  updatedAt     DateTime         @updatedAt
  rentals       CarRental[]
  schedules     DriverSchedule[]

  @@map("drivers")
}

model DriverSchedule {
  id        String   @id @default(cuid())
  driverId  String   @map("driver_id")
  date      DateTime @db.Date
  status    String   @default("available")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, date])
  @@index([date, status])
  @@map("driver_schedules")
}

model Staff {
  id               String          @id @default(cuid())
  name             String
  phone            String
  avatar           String?
  staffType        String          @map("staff_type")
  status           String          @default("active")
  dailyWage        Int             @default(0) @map("daily_wage")
  idNumber         String?         @map("id_number")
  emergencyContact String?         @map("emergency_contact")
  emergencyPhone   String?         @map("emergency_phone")
  hireDate         DateTime?       @map("hire_date")
  remark           String?
  createdAt        DateTime        @default(now()) @map("create_time")
  updatedAt        DateTime        @updatedAt
  schedules        StaffSchedule[]

  @@index([staffType])
  @@index([status])
  @@map("staffs")
}

model StaffSchedule {
  id        String   @id @default(cuid())
  staffId   String   @map("staff_id")
  date      DateTime @db.Date
  status    String   @default("scheduled")
  workHours Int?     @map("work_hours")
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date, status])
  @@map("staff_schedules")
}

model Category {
  id        String   @id @default(cuid())
  labelZh   String   @map("label_zh")
  labelEn   String   @map("label_en")
  labelTh   String   @map("label_th")
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now()) @map("create_time")
  updatedAt   DateTime @updatedAt

  @@map("transactions")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("create_time")
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model TicketConfig {
  id          String        @id @default(cuid())
  name        String
  description String?
  image       String
  price       Int
  ticketType  String        @map("ticket_type")
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("create_time")
  updatedAt   DateTime      @updatedAt
  orders      TicketOrder[]

  @@map("ticket_configs")
}

model TicketOrder {
  id             String       @id @default(cuid())
  roomNumber     String       @map("room_number")
  ticketConfigId String       @map("ticket_config_id")
  quantity       Int
  totalPrice     Int          @map("total_price")
  visitDate      DateTime?    @map("visit_date")
  remark         String?
  status         String       @default("CONFIRMED")
  createdAt      DateTime     @default(now()) @map("create_time")
  updatedAt      DateTime     @updatedAt
  ticketConfig   TicketConfig @relation(fields: [ticketConfigId], references: [id])

  @@map("ticket_orders")
}

model BusinessConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("business_configs")
}

model Review {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  houseId   String    @map("house_id")
  orderId   String    @unique @map("order_id")
  rating    Int
  content   String?
  images    String[]
  reply     String?
  replyAt   DateTime? @map("reply_at")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  house     Homestay  @relation(fields: [houseId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([houseId])
  @@index([userId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  content   String
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Cost {
  id          String   @id @default(cuid())
  costType    String   @map("cost_type")
  amount      Int
  date        DateTime @db.Date
  description String?
  relatedId   String?  @map("related_id")
  relatedType String?  @map("related_type")
  status      String   @default("confirmed")
  remark      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([costType])
  @@index([date])
  @@index([status])
  @@map("costs")
}

model UsageLimit {
  id                String   @id @default(cuid())
  service           String
  resourceType      String   @map("resource_type")
  limitValue        Int      @map("limit_value")
  unit              String
  warningThreshold  Int      @default(80) @map("warning_threshold")
  criticalThreshold Int      @default(95) @map("critical_threshold")
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([service, resourceType])
  @@index([service])
  @@map("usage_limits")
}

model UsageLog {
  id           String   @id @default(cuid())
  service      String
  resourceType String   @map("resource_type")
  usedValue    Int      @map("used_value")
  unit         String
  percentage   Float
  status       String   @default("normal")
  recordedAt   DateTime @default(now()) @map("recorded_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([service, resourceType])
  @@index([recordedAt])
  @@map("usage_logs")
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  description    String?
  type           String
  value          Int
  minAmount      Int          @default(0) @map("min_amount")
  maxDiscount    Int?         @map("max_discount")
  totalCount     Int          @default(0) @map("total_count")
  usedCount      Int          @default(0) @map("used_count")
  perUserLimit   Int          @default(1) @map("per_user_limit")
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  applicableType String       @default("all") @map("applicable_type")
  applicableIds  String?      @map("applicable_ids")
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  userCoupons    UserCoupon[]

  @@index([code])
  @@index([status])
  @@index([startTime, endTime])
  @@map("coupons")
}

model UserCoupon {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  couponId  String    @map("coupon_id")
  orderId   String?   @map("order_id")
  status    String    @default("available")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
  @@map("user_coupons")
}

model Promotion {
  id             String   @id @default(cuid())
  name           String
  description    String?
  type           String
  discountValue  Int      @default(0) @map("discount_value")
  discountType   String   @default("percent") @map("discount_type")
  applicableType String   @default("all") @map("applicable_type")
  applicableIds  String?  @map("applicable_ids")
  startTime      DateTime @map("start_time")
  endTime        DateTime @map("end_time")
  image          String?
  bannerText     String?  @map("banner_text")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([applicableType])
  @@index([startTime, endTime])
  @@map("promotions")
}

model Merchant {
  id           String            @id @default(cuid())
  userId       String            @unique @map("user_id")
  name         String
  phone        String
  email        String?
  avatar       String?
  description  String?
  status       String            @default("pending")
  commission   Int               @default(10)
  bankName     String?           @map("bank_name")
  bankAccount  String?           @map("bank_account")
  remark       String?
  rejectReason String?           @map("reject_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  products     MerchantProduct[]

  @@index([status])
  @@map("merchants")
}

model MerchantProduct {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  productType String   @map("product_type")
  productId   String   @map("product_id")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, productType, productId])
  @@map("merchant_products")
}
